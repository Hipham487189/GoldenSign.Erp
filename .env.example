# =========================================================
# MAU CAU HINH BIEN MOI TRUONG (SERVER CHINH THUC)
# Sao chep thanh .env va dien gia tri that (khong dua .env len Git)
# =========================================================

# 1. Ung dung & May chu
NODE_ENV=production
PORT=5000
CORS_ORIGIN=

# 2. Tinh nang don nhieu san pham
DON_NHIEU_SAN_PHAM_ENABLED=true
TAO_DON_NHIEU_SAN_PHAM_ENABLED=true
UNC_NHIEU_SAN_PHAM_ENABLED=true

# 3. Co so du lieu MongoDB
MONGO_URI=
MONGO_DB_NAME=DATAGS

# 4. Xac thuc & Tai khoan quan tri mac dinh
JWT_SECRET=
PASSWORD_RESET_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 5. Dong bo Google Sheets - Don hang
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=GS-DONHANG
GOOGLE_SHEET_DONHANG_NAME=DONHANG
GOOGLE_SHEET_SYNC_ENABLED=true
GOOGLE_SHEET_SYNC_DIRECTION=sheet-to-mongo
GOOGLE_SHEET_SYNC_ALLOW_DELETES=false
GOOGLE_CREDENTIALS_JSON=

# 6. Dong bo Google Sheets - Thanh toan, Giao nhan, Ho so
THANH_TOAN_SYNC_ENABLED=
THANH_TOAN_SHEET_ID=
GIAO_NHAN_SYNC_ENABLED=
GOOGLE_GIAO_NHAN_SHEET_ID=
GOOGLE_GIAO_NHAN_SHEET_NAME=
GOOGLE_HOSO_SHEET_ID=
GOOGLE_HOSO_SHEET_NAME=
GOOGLE_HOSO_SHEET_GID=

# 7. Tich hop SmartSign (Hoa don dien tu)
SMARTSIGN_USER=
SMARTSIGN_PASS=

# 8. Tro ly AI Gemini & Anh nen dang nhap
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
UNSPLASH_ACCESS_KEY=

# 9. Gui OTP khoi phuc mat khau (Brevo Email / SMS)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
RESET_SMS_API_URL=
RESET_SMS_API_TOKEN=
